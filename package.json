{
  "name": "reading-tracker",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first Reading Tracker (Express + SQLite + React)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "check": "node server/scripts/acceptance.js",
    "verify": "node server/scripts/verify.js",
    "test": "node --test \"server/tests/**/*.test.js\"",
    "build:pwa": "node server/scripts/buildPwa.js",
    "dev:pwa": "node server/scripts/buildPwa.js --dev"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tanstack/react-query": "^5.105.3",
    "better-sqlite3": "^12.4.1",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
