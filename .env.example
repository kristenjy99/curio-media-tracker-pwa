# Cổng và host của local server. Giữ 127.0.0.1 để server không lộ ra mạng LAN.
PORT=4317
HOST=127.0.0.1

# Thư mục lưu trữ (DB, notes, uploads). Bỏ trống để dùng ./data hoặc giá trị trong ~/.reading-tracker/config.json
READING_TRACKER_STORAGE=

# Thư mục chứa config.json (đường dẫn storage do app ghi khi đổi thư mục). Bỏ trống = ~/.reading-tracker
READING_TRACKER_CONFIG_DIR=

# DELETE an toàn hơn khi thư mục nằm trong Google Drive/OneDrive/Obsidian Sync; WAL nhanh hơn khi thư mục thuần local.
SQLITE_JOURNAL_MODE=DELETE

# Origin của Vite dev server được phép gọi API.
CLIENT_ORIGIN=http://localhost:5173

# Client ID của OAuth Client (Google Cloud, loại Web application) cho đồng bộ Google Drive trên bản điện thoại.
# Chỉ dùng khi build bản PWA. Không có client secret. Trên GitHub Actions đặt ở repository variable cùng tên.
VITE_GOOGLE_CLIENT_ID=
